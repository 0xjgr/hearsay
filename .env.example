# any openai-compatible chat completions endpoint; defaults to local ollama
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen3:8b
MODEL_API_KEY=
# none turns reasoning off; qwen3 treats any other value as on
MODEL_REASONING=high

# desk api (pnpm desk); binds to 127.0.0.1 only
DESK_PORT=8787
# 1 lets allowed and approved proposals reach paypal; 0 is dry run
DESK_SEND=0
# seconds between dispute listings; 0 turns polling off
DESK_POLL_SECONDS=0
# disputes never written to, comma separated (the demo cases)
DESK_FROZEN=PP-R-PPO-10194554,PP-R-BJT-10194552,PP-R-AMO-10194550
