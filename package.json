{
  "name": "hearsay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc && tsc -p desk/ui",
    "fixtures": "node --env-file-if-exists=.env bench/run-fixtures.ts",
    "desk": "node --env-file-if-exists=../.env --env-file-if-exists=.env desk/serve-desk.ts",
    "dispute": "node --env-file-if-exists=../.env --env-file-if-exists=.env paypal/run-dispute.ts",
    "guard-agent": "node --env-file-if-exists=../.env --env-file-if-exists=.env paypal/run-guarded-agent.ts",
    "ui": "vite desk/ui",
    "build": "vite build desk/ui",
    "judges": "node bench/serve-judges.ts",
    "bench:record": "node bench/record-bench.ts",
    "bench": "node --env-file-if-exists=.env bench/run-corpus.ts",
    "bench:scores": "node bench/print-scores.ts",
    "bench:toolkit": "node --env-file-if-exists=.env bench/run-toolkit-corpus.ts",
    "bench:toolkit-scores": "node bench/print-toolkit-scores.ts"
  },
  "dependencies": {
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@7.3.7",
    "@bryntum/scheduler-react": "7.3.7",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@hono/node-server": "2.1.4",
    "@paypal/agent-toolkit": "1.11.0",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
